# Copy to a root-readable file outside git, for example /home/cordel/cordel-host.env,
# then replace every CHANGE_ME. Run scripts with:
#   sudo CORDEL_HOST_ENV=/home/cordel/cordel-host.env bash bootstrap.sh
# Do not commit the filled-in file. The public IP is not a secret, but it does
# not belong in the repository. The DuckDNS token belongs in /etc/cordel/duckdns.env.
# Point that file's CORDEL_HOST_ENV at this profile so a public-IP change updates
# CORDEL_NODE_IP together with LiveKit rtc.node_ip.

CORDEL_MEDIA_HOST=CHANGE_ME.duckdns.org
CORDEL_TURN_HOST=CHANGE_ME.duckdns.org
CORDEL_NODE_IP=CHANGE_ME
CORDEL_MEDIA_BIND=172.16.1.16
CORDEL_SIGNAL_BIND=127.0.0.1
CORDEL_ICE_BIND=172.16.1.16
CORDEL_TURN_BIND=172.16.1.16
CORDEL_TURN_HTTP_BIND=172.16.1.16
CORDEL_TURN_TLS_PORT=5349
CORDEL_FIREWALL_IF=eth0
CORDEL_REQUIRED_ADDRS="172.16.1.16"
CORDEL_ACME_EMAIL=CHANGE_ME
CORDEL_TURN_CERT_MODE=caddy
CORDEL_INSTALL_CERTBOT=0
CORDEL_IDENTITY_USER=cordel-api
CORDEL_IDENTITY_GROUP=cordel-api
CORDEL_LIVEKIT_UPSTREAM=127.0.0.1:7880
CORDEL_ENABLE_MEDIA_GATE=1
CORDEL_IDENTITY_SCHEMA_STATE=current-4
CORDEL_ADVERTISE_INTERNAL_IP=1
CORDEL_RTC_INTERFACE_EXCLUDES=docker0
CORDEL_ACCEPT_WILDCARD_ICE=1
CORDEL_BACKUP_STOCK_CADDY=1
CORDEL_WARN_DOCKER=1
CORDEL_DENY_INTERNAL_PORTS=1
CORDEL_EDGE_NOTE=the router port-forwards
